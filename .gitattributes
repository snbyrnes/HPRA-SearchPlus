# Auto-detect text files and normalise line endings
* text=auto

# XML data files - treat as text
*.xml text

# Web assets
*.html text
*.css text
*.js text
*.md text
*.json text

# Generated data — keep huge diffs out of PRs / blame
data/products.json linguist-generated=true -diff
data/products-withdrawn.json linguist-generated=true -diff
data/changes.json linguist-generated=true
data/atc-dictionary.json linguist-generated=true -diff
